#!/usr/bin/expect -f
set timeout 30
spawn ssh -p 2121 -o StrictHostKeyChecking=no aknkrds@192.168.1.100

expect {
    "*Password:*" {
        send "DorukNaz2010\r"
    }
    "*password:*" {
        send "DorukNaz2010\r"
    }
}

expect "*$"

send "echo '--- SYSTEM INFO ---' && uname -a\r"
expect "*$"

send "echo '--- NGINX CONFIGS ---' && ls -la /etc/nginx/sites-enabled/\r"
expect "*$"

send "echo '--- CONTENT OF CONFIGS ---' && tail -n +1 /etc/nginx/sites-enabled/*\r"
expect "*$"

send "echo '--- NGINX RUNNING STATUS ---' && systemctl status nginx\r"
expect "*$"

send "echo '--- LISTEN PORTS ---' && sudo netstat -tulpn | grep -E '80|443'\r"
expect {
    "*password for aknkrds:*" {
        send "DorukNaz2010\r"
        exp_continue
    }
    "*$"
}

send "echo '--- WEB ROOT CONTENTS ---' && ls -la /var/www/akinkaradas.com.tr/\r"
expect "*$"

send "echo '--- DIST DIRECTORY ---' && ls -la /var/www/akinkaradas.com.tr/dist/\r"
expect "*$"

send "exit\r"
expect eof
